FeCap capacitance hysteresis simulation

ground 0

// Generic devices...
load "resistor.osdi"

// ... and their models (create masters)
model resistor resistor
model isource isource
model vsource vsource

// FeCap (Heracles) model
include "../../models/fecap.lib"

// Capacitance hysteresis testbench
subckt capacitance()
  parameters vreset=-3 vset=1
  vpulse (vin_i 0) vsource type="pulse" dc=0 mag=1 delay=0 rise=1u fall=1u width=1
  vsine (vin vin_i) vsource type="sine" dc=0 mag=1 delay=1m ampl=42m freq=100k
  r1 (vin te) resistor r=50
  x1 (te 0) fecap area=1e-12
ends

control
  abort always
  options op_debug=0 homotopy_debug=0 nr_debug=0 matrixcheck=1 tran_method="trap"

  elaborate circuit("capacitance")
  save (
    default
  )

  sweep reset instance="vpulse" parameter="val0" values=[-5, 5]
    sweep set instance="vpulse" parameter="val1" from=-5 to=5 mode="lin" points=50
      analysis cv tran stop=1.6m step=10n maxstep=50n


  postprocess(PYTHON, "cv.py")
endc
